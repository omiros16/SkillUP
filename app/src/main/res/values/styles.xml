<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#FF000000</item>
        <item name="android:colorPrimaryDark">#FF000000</item>
        <item name="android:colorAccent">#FFA497D9</item>
        <item name="android:textColorHighlight">#66A497D9</item>
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:colorBackground">#FF1C1A24</item>
        <item name="android:fontFamily">@font/geologica</item>
        <item name="android:popupMenuStyle">@style/Popup</item>
        <item name="android:textAppearanceLargePopupMenu">@style/PopupText</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/PopupText</item>
    </style>

    <!-- Alert dialogs and the time picker: a rounded floating card instead of the square Material-1 slab. -->
    <style name="DialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">#FF1C1A24</item>
        <item name="android:fontFamily">@font/geologica</item>
        <item name="android:colorAccent">#FFA497D9</item>
        <item name="android:textColorPrimary">#FFE6E3EE</item>
        <item name="android:textColorSecondary">#FFA29EB0</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
        <item name="android:timePickerStyle">@style/TimePickerSoft</item>
    </style>

    <!-- Greek capitals drop their accents; sentence case avoids «ΆΚΥΡΟ». -->
    <style name="DialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/geologica_semibold</item>
        <item name="android:textColor">#FFA497D9</item>
    </style>

    <style name="TimePickerSoft" parent="@android:style/Widget.Material.TimePicker">
        <item name="android:headerBackground">#FF272431</item>
        <item name="android:numbersBackgroundColor">#FF272431</item>
        <item name="android:numbersSelectorColor">#FFA497D9</item>
        <item name="android:numbersTextColor">#FFE6E3EE</item>
    </style>

    <!-- Task editor: floating bottom sheet. -->
    <style name="SheetTheme" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowAnimationStyle">@style/SheetAnim</item>
    </style>

    <style name="SheetAnim">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <!-- Filled, rounded text field; no underline. -->
    <style name="SheetField" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#FFE6E3EE</item>
        <item name="android:textColorHint">#FF918DA0</item>
        <item name="android:fontFamily">@font/geologica_regular</item>
        <item name="android:textCursorDrawable">@drawable/cursor</item>
        <item name="android:textColorHighlight">#66A497D9</item>
    </style>

    <style name="Popup" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_bg</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="PopupText" parent="@android:style/TextAppearance.Material.Widget.PopupMenu.Large">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#FFE6E3EE</item>
        <item name="android:fontFamily">@font/geologica_medium</item>
    </style>
</resources>
